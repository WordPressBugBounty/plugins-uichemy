{
  "version": 1,
  "source": "docs/page-cache research HOSTS.md, 2026-10-03. Only grade A signals switch mode automatically; B and C give a suggestion.",
  "hosts": [
    {
      "id": "kinsta",
      "name": "Kinsta",
      "caches_pages": true,
      "behaviour": "stand_down",
      "ttl": "24 hours",
      "signals": [
        {
          "type": "header",
          "name": "ki-cache-type",
          "grade": "A"
        },
        {
          "type": "header",
          "name": "ki-cf-cache-status",
          "grade": "A"
        },
        {
          "type": "header",
          "name": "x-kinsta-cache",
          "grade": "B"
        },
        {
          "type": "constant",
          "name": "KINSTAMU_VERSION",
          "grade": "B"
        }
      ],
      "hit_headers": {
        "x-kinsta-cache": "hit",
        "ki-cf-cache-status": "hit"
      },
      "purge": {
        "method": "none"
      },
      "docs": "host/kinsta",
      "verified_on": "2026-10-03"
    },
    {
      "id": "wpengine",
      "name": "WP Engine",
      "caches_pages": true,
      "behaviour": "stand_down",
      "ttl": "10 minutes",
      "signals": [
        {
          "type": "header",
          "name": "x-cache-group",
          "grade": "A"
        },
        {
          "type": "header",
          "name": "x-pass-why",
          "grade": "A"
        },
        {
          "type": "class",
          "name": "WpeCommon",
          "grade": "A"
        }
      ],
      "hit_headers": {
        "x-cache": "hit"
      },
      "purge": {
        "method": "static_call",
        "class": "WpeCommon",
        "function": "purge_varnish_cache",
        "grade": "A"
      },
      "docs": "host/wpengine",
      "verified_on": "2026-10-03"
    },
    {
      "id": "siteground",
      "name": "SiteGround",
      "caches_pages": true,
      "behaviour": "stand_down",
      "ttl": "12 hours",
      "signals": [
        {
          "type": "header",
          "name": "x-proxy-cache",
          "grade": "A"
        }
      ],
      "hit_headers": {
        "x-proxy-cache": "hit"
      },
      "purge": {
        "method": "function",
        "function": "sg_cachepress_purge_cache",
        "note": "SiteGround Optimizer's own purge (verify on a SiteGround site).",
        "requires": "the SiteGround Optimizer plugin is active"
      },
      "docs": "host/siteground",
      "verified_on": "2026-10-03"
    },
    {
      "id": "cloudways",
      "name": "Cloudways",
      "caches_pages": true,
      "behaviour": "stand_down",
      "ttl": "4 hours",
      "signals": [
        {
          "type": "header",
          "name": "x-varnish",
          "grade": "C"
        }
      ],
      "hit_headers": {
        "x-cache": "hit"
      },
      "purge": {
        "method": "action",
        "action": "breeze_clear_varnish",
        "note": "Breeze's Varnish purge; only when Breeze is active (verify on Cloudways).",
        "requires": "the Breeze plugin is active"
      },
      "docs": "host/cloudways",
      "verified_on": "2026-10-03"
    },
    {
      "id": "litespeed",
      "name": "LiteSpeed",
      "caches_pages": false,
      "behaviour": "coexist",
      "note": "Hostinger, A2 / hosting.com. The server caches pages only through the LiteSpeed Cache plugin; that plugin is detected separately.",
      "signals": [
        {
          "type": "header",
          "name": "x-litespeed-cache",
          "grade": "C"
        },
        {
          "type": "server_software",
          "match": "litespeed",
          "grade": "B"
        }
      ],
      "hit_headers": {
        "x-litespeed-cache": "hit"
      },
      "purge": {
        "method": "header",
        "header": "X-LiteSpeed-Purge",
        "note": "LiteSpeed Web Server purges on this response header; needs no plugin (verify on LiteSpeed)."
      },
      "docs": "host/litespeed",
      "verified_on": "2026-10-03"
    },
    {
